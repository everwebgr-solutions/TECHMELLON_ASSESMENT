# ── ElevenLabs ───────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=                        # populated after first run of setup
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # Rachel (default)

# ── LLM Providers ────────────────────────────────────────────
# Ollama (local, default — no key needed)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI (optional quality upgrade)
OPENAI_API_KEY=

# Anthropic (optional quality upgrade)
ANTHROPIC_API_KEY=

# ── LLM Routing ──────────────────────────────────────────────
# Format: "provider/model"  e.g.  ollama/llama3.2  or  openai/gpt-4o
LLM_SIMULATOR=ollama/llama3.2
LLM_EVALUATOR=ollama/llama3.2
LLM_PROMPT_FIXER=ollama/qwen2.5-coder
LLM_CODE_PATCHER=ollama/qwen2.5-coder

# ── Refinement Loop ───────────────────────────────────────────
MAX_ITERATIONS=5
PASS_THRESHOLD=8.0
MAX_CONVERSATION_TURNS=12

# ── API ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8001

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/airline.db
